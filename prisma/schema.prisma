generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  SALESMAN
  ADMIN
  SUPER_ADMIN
  INVESTOR
}

enum OrderSource {
  WEBSITE
  SHOWROOM
  WHOLESALE
  MANUAL
}

enum SaleType {
  SINGLE
  BULK
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  COMPLETED
  CANCELED
  RETURNED
}

enum ExpenseStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELED
}

enum CartItemStatus {
  IN_CART
  ORDERED
  SOLD
}

enum PaymentProvider {
  DGEPAY
  BKASH
  NAGAD
  ROCKET
  SSLCOMMERZ
  STRIPE
  CASH
  OTHER
}

enum PaymentState {
  INITIATED
  COMPLETED
  FAILED
  CANCELED
  REFUNDED
}

type PerfumeNotes {
  top    String[]
  middle String[]
  base   String[]
}

model User {
  id                      String    @id @default(auto()) @map("_id") @db.ObjectId
  name                    String
  email                   String    @unique
  password                String?
  imageUrl                String?
  phone                   String?
  address                 String?
  district                String?
  role                    Role      @default(USER)
  isVerified              Boolean   @default(false)
  isApproved              Boolean   @default(true)
  resetToken              String?
  resetTokenExpiry        DateTime?
  verificationToken       String?
  verificationTokenExpiry DateTime?
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  Blog           Blog[]
  Review         Review[]
  orderItems     CartItem[]
  wishlist       Wishlist[]
  Expense        Expense[]
  customerOrders Order[]    @relation("CustomerOrders")
  salesmanOrders Order[]    @relation("SalesmanOrders")
  investor       Investor?

  @@map("users")
}

model Category {
  id           String    @id @default(auto()) @map("_id") @db.ObjectId
  categoryName String    @unique
  imageUrl     String?
  sizes        String[]  @default([])
  unit         String?
  published    Boolean   @default(false)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  Product      Product[]

  @@map("categories")
}

model Material {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  materialName String   @unique
  imageUrl     String?
  published    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  ProductMaterial ProductMaterial[]

  @@map("materials")
}

model Fragrance {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  fragranceName String   @unique
  imageUrl      String?
  published     Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  ProductFragrance ProductFragrance[]

  @@map("fragrances")
}

model Product {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String   @unique
  description  String
  primaryImage String
  otherImages  String[]
  videos       String[] @default([])
  tags         String[]
  salesCount   Int      @default(0)
  published    Boolean  @default(false)

  // ==========================================
  // 🌍 SEO, GOOGLE & META CATALOG FIELDS 🌍
  // ==========================================
  brand                 String? // Required for Google Shopping / Meta Brand attribute
  condition             String  @default("new") // "new", "refurbished", "used"
  itemGroupId           String? // Parent item group ID for variant grouping
  googleProductCategory String? // e.g., "Health & Beauty > Personal Care > Cosmetics > Perfume"
  gender                String? // "unisex", "male", "female"
  metaTitle             String?
  metaDescription       String?

  // Perfume specifications
  origin       String?
  perfumeNotes PerfumeNotes?
  accords      String[]
  performance  String?
  longevity    String?
  projection   String?
  sillage      String?
  bestFor      String[]

  categoryId String   @db.ObjectId
  category   Category @relation(fields: [categoryId], references: [id])

  ProductMaterial  ProductMaterial[]
  ProductFragrance ProductFragrance[]

  variants      ProductVariant[]
  comboVariants ComboVariant[]

  supplier  String?
  stock     Float      @default(0)
  stocklogs StockLog[]

  discounts  Discount[]
  Review     Review[]
  orderItems CartItem[]
  wishlist   Wishlist[]

  minPrice      Float @default(0)
  maxPrice      Float @default(0)
  averageRating Float @default(0)
  reviewCount   Int   @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([categoryId, published])
  @@index([minPrice])
  @@index([averageRating])
  @@map("products")
}

model ProductVariant {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  productId String @db.ObjectId
  sku       String @unique
  unit      String
  size      Float
  price     Float

  isDefault Boolean @default(false)
  published Boolean @default(true)

  gtin           String?
  mpn            String?
  barcode        String?
  compareAtPrice Float?
  costPrice      Float?
  weightGrams    Float?

  stock         Float @default(0)
  lowStockAlert Float @default(5)

  attributes Json?
  images     String[] @default([])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  product       Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  comboVariants ComboVariant[]
  orderItems    CartItem[]
  stocklogs     StockLog[]
  discounts     Discount[]

  @@map("product_variants")
}

model ProductMaterial {
  id         String @id @default(auto()) @map("_id") @db.ObjectId
  productId  String @db.ObjectId
  materialId String @db.ObjectId

  product  Product  @relation(fields: [productId], references: [id])
  material Material @relation(fields: [materialId], references: [id])

  @@unique([productId, materialId])
  @@map("product_materials")
}

model ProductFragrance {
  id          String @id @default(auto()) @map("_id") @db.ObjectId
  productId   String @db.ObjectId
  fragranceId String @db.ObjectId

  product   Product   @relation(fields: [productId], references: [id])
  fragrance Fragrance @relation(fields: [fragranceId], references: [id])

  @@unique([productId, fragranceId])
  @@map("product_fragrances")
}

model ComboProduct {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  description  String?
  primaryImage String
  otherImages  String[]
  price        Float
  published    Boolean  @default(false)
  tags         String[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variants ComboVariant[]

  @@map("combo_products")
}

model ComboVariant {
  id        String @id @default(auto()) @map("_id") @db.ObjectId
  comboId   String @db.ObjectId
  productId String @db.ObjectId
  variantId String @db.ObjectId
  quantity  Int    @default(1)

  combo   ComboProduct   @relation(fields: [comboId], references: [id])
  product Product        @relation(fields: [productId], references: [id])
  variant ProductVariant @relation(fields: [variantId], references: [id])

  @@map("combo_variants")
}

model Order {
  id          String      @id @default(auto()) @map("_id") @db.ObjectId
  invoice     String      @unique
  orderTime   DateTime    @default(now())
  payToken    String?
  amount      Float
  isPaid      Boolean
  method      String?
  cartItems   Json?
  status      OrderStatus @default(PENDING)
  orderSource OrderSource
  platform    String?
  productIds  String[]

  coupon         String?
  discountAmount Int     @default(0)

  customerId String? @db.ObjectId
  customer   User?   @relation("CustomerOrders", fields: [customerId], references: [id])

  shippingCost    Float   @default(0)
  additionalNotes String?
  shipping        Json?
  billing         Json?

  salesmanId String?   @db.ObjectId
  salesman   User?     @relation("SalesmanOrders", fields: [salesmanId], references: [id])
  saleType   SaleType?

  name    String?
  phone   String?
  email   String?
  address String?

  orderItems CartItem[] @relation("Order_CartItems")

  payments       Payment[]
  orderDiscounts OrderDiscount[]

  orderItemCosts OrderItemCost[]

  consignmentId  Int?    @unique
  trackingCode   String?
  trackingLink   String?
  deliveryCharge Float?  @default(0)
  courierStatus  String?

  // true once this order's stock has been put back (canceled/returned). See utils/orderStock.ts
  stockReturned Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("orders")
}

model CartItem {
  id            String  @id @default(auto()) @map("_id") @db.ObjectId
  userId        String? @db.ObjectId
  productId     String  @db.ObjectId
  variantId     String? @db.ObjectId
  size          Float? // same type as ProductVariant.size (was Int: a 2.5 ml size could not be saved)
  unit          String?
  quantity      Int
  price         Float
  originalPrice Float?
  discount      Float?

  status CartItemStatus @default(IN_CART)

  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])
  user    User?           @relation(fields: [userId], references: [id])

  orderId String? @db.ObjectId
  order   Order?  @relation("Order_CartItems", fields: [orderId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("cart_items")
}

model StockLog {
  id        String          @id @default(auto()) @map("_id") @db.ObjectId
  productId String          @db.ObjectId
  variantId String?         @db.ObjectId
  product   Product         @relation(fields: [productId], references: [id])
  variant   ProductVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  change    Float
  reason    String
  createdAt DateTime        @default(now())

  @@map("stock_logs")
}

model Payment {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId String? @db.ObjectId

  amount   Float
  provider PaymentProvider
  status   PaymentState    @default(INITIATED)

  gatewayPaymentId String? @unique
  gatewayTrxId     String?
  gatewayInvoice   String?
  gatewayStatus    String?

  refundedAmount Float?  @default(0)
  refundTrxId    String?
  refundStatus   String?

  gatewayResponse Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  order Order? @relation(fields: [orderId], references: [id])

  @@map("payments")
}

enum DiscountScope {
  ORDER
  PRODUCT
  VARIANT
}

model Discount {
  id String @id @default(auto()) @map("_id") @db.ObjectId

  scope DiscountScope @default(PRODUCT)

  productId String? @db.ObjectId
  variantId String? @db.ObjectId

  code  String? @unique
  type  String
  value Float

  maxUsage  Int?
  usedCount Int       @default(0)
  startDate DateTime?
  endDate   DateTime?

  product Product?        @relation(fields: [productId], references: [id])
  variant ProductVariant? @relation(fields: [variantId], references: [id])

  OrderDiscount OrderDiscount[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("discounts")
}

model OrderDiscount {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId    String   @db.ObjectId
  discountId String   @db.ObjectId
  order      Order    @relation(fields: [orderId], references: [id])
  discount   Discount @relation(fields: [discountId], references: [id])
}

model Expense {
  id          String        @id @default(auto()) @map("_id") @db.ObjectId
  expenseTime DateTime      @default(now())
  amount      Float
  method      String
  isPaid      Boolean
  title       String?
  description String?
  reference   String?
  status      ExpenseStatus @default(PENDING)
  // One of EXPENSE_CATEGORIES (modules/Expense/expense.constant.ts); null = uncategorized
  category    String?

  expenseById String? @db.ObjectId
  expenseBy   User?   @relation(fields: [expenseById], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("expenses")
}

model Blog {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  title           String
  content         String
  imageUrl        String?
  imageAltText    String?
  others          String? // Used to store serialized JSON like FAQs / structured data
  keywords        String? // Can also include tags comma-separated
  isPublish       Boolean  @default(false)
  userId          String   @db.ObjectId
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  metaTitle       String?
  metaDescription String?
  slug            String   @unique

  user User @relation(fields: [userId], references: [id])

  @@map("blogs")
}

model Review {
  id          String  @id @default(auto()) @map("_id") @db.ObjectId
  rating      Int
  title       String
  email       String?
  comment     String
  imageUrl    String?
  isPublished Boolean @default(false)
  productId   String  @db.ObjectId
  userId      String? @db.ObjectId

  product Product @relation(fields: [productId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("reviews")
}

model Wishlist {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("wishlist_items")
}

// ============================================================
// 📊 FINANCE, INVENTORY & COSTING MODELS
// ============================================================

enum CostCategory {
  STOCK_BILL
  CARRYING
  BOTTLE
  PACKAGING
  LABEL
  COURIER
  COD_FEE
  GIFT_WRAP
  OTHER
}

// Embedded type for cost breakdowns (MongoDB specific)
type CostLine {
  category CostCategory
  label    String?
  amount   Float
}

// 1. Logs every time liquid stock is purchased/added
model StockPurchase {
  id           String     @id @default(auto()) @map("_id") @db.ObjectId
  productId    String     @db.ObjectId
  billNo       String?
  supplier     String?
  purchaseDate DateTime   @default(now())
  quantity     Float
  unit         String?
  costLines    CostLine[] // Array of bills, carrying costs, etc.
  totalCost    Float
  costPerUnit  Float // totalCost / quantity
  isOpening    Boolean    @default(false) // True if this was pre-existing stock
  note         String?
  createdById  String?    @db.ObjectId
  createdAt    DateTime   @default(now())

  @@index([productId, purchaseDate])
  @@map("stock_purchases")
}

// 2. The live Weighted Average Cost (WAC) per ML/GM for a product
model ProductCost {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  productId       String   @unique @db.ObjectId
  avgCostPerUnit  Float
  lastCostPerUnit Float
  updatedAt       DateTime @updatedAt

  @@map("product_costs")
}

// 3. Flat packaging costs (Bottle, Box, Label) keyed to the exact SKU
model VariantPackagingCost {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  sku       String     @unique
  costLines CostLine[]
  totalCost Float
  updatedAt DateTime   @updatedAt

  @@map("variant_packaging_costs")
}

// 4. Flat packaging costs specifically for Combo/Gift Boxes
model ComboPackagingCost {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  comboId   String     @unique @db.ObjectId
  costLines CostLine[]
  totalCost Float
  updatedAt DateTime   @updatedAt

  @@map("combo_packaging_costs")
}

// 5. Historical frozen snapshot of EXACT costs at the moment an order was placed
model OrderItemCost {
  id                String   @id @default(auto()) @map("_id") @db.ObjectId
  orderId           String   @db.ObjectId
  cartItemId        String?  @db.ObjectId
  productId         String?  @db.ObjectId
  variantId         String?  @db.ObjectId
  comboId           String?  @db.ObjectId
  quantity          Int
  sellingUnitPrice  Float
  liquidUnitCost    Float
  packagingUnitCost Float
  unitCost          Float
  totalCost         Float
  totalRevenue      Float
  profit            Float
  costMissing       Boolean  @default(false) // True if sold while cost was unknown
  createdAt         DateTime @default(now())
  order             Order    @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("order_item_costs")
}

// 6. Manual extra costs added to an order (e.g., special gift wrap, custom card)
model OrderExtraCost {
  id        String     @id @default(auto()) @map("_id") @db.ObjectId
  orderId   String     @unique @db.ObjectId
  costLines CostLine[]
  totalCost Float
  updatedAt DateTime   @updatedAt

  @@map("order_extra_costs")
}

// 📈 DEDICATED INVESTOR MODEL
model Investor {
  id     String @id @default(auto()) @map("_id") @db.ObjectId
  userId String @unique @db.ObjectId
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  profitSharePercentage Float @default(0)
  totalInvested         Float @default(0) // Actual money they gave you
  currentBalance        Float @default(0) // Available to withdraw

  withdrawals    InvestorWithdrawal[]
  monthlyProfits InvestorMonthlyProfit[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("investors")
}

model InvestorWithdrawal {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  investorId  String           @db.ObjectId
  investor    Investor         @relation(fields: [investorId], references: [id], onDelete: Cascade)
  amount      Float
  status      WithdrawalStatus @default(PENDING)
  method      String?
  reference   String?
  note        String?
  requestDate DateTime         @default(now())
  processedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("investor_withdrawals")
}

enum WithdrawalStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model InvestorMonthlyProfit {
  id               String   @id @default(auto()) @map("_id") @db.ObjectId
  investorId       String   @db.ObjectId
  investor         Investor @relation(fields: [investorId], references: [id], onDelete: Cascade)
  year             Int
  month            Int
  companyNetProfit Float
  shareAmount      Float
  isDistributed    Boolean  @default(false)
  // Audit: % used and when/who credited it (set on SUPER_ADMIN approval)
  sharePercentage  Float?
  distributedAt    DateTime?
  distributedById  String?  @db.ObjectId

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([investorId, year, month])
  @@map("investor_monthly_profits")
}

enum LedgerAccessStatus {
  PENDING
  APPROVED
  REJECTED
}

// An investor's request to view the full company ledger. Each view window needs a
// SUPER_ADMIN approval and expires (DECISIONS D-007).
// Every manual change to an investor's capital, balance or share % (Manage Investors / Role Manager),
// so balances can be reconciled: balance = opening + manual changes + credited profit - withdrawals.
model InvestorAdjustment {
  id         String   @id @default(auto()) @map("_id") @db.ObjectId
  investorId String   @db.ObjectId
  field      String // "totalInvested" | "currentBalance" | "profitSharePercentage"
  before     Float
  after      Float
  source     String // "MANAGE_INVESTORS" | "ROLE_MANAGER"
  note       String?
  byId       String?  @db.ObjectId
  createdAt  DateTime @default(now())

  @@index([investorId, createdAt])
  @@map("investor_adjustments")
}

model LedgerAccessRequest {
  id           String             @id @default(auto()) @map("_id") @db.ObjectId
  userId       String             @db.ObjectId
  status       LedgerAccessStatus @default(PENDING)
  reason       String?
  requestedAt  DateTime           @default(now())
  decidedAt    DateTime?
  decidedById  String?            @db.ObjectId
  expiresAt    DateTime?

  @@index([userId, status])
  @@map("ledger_access_requests")
}
